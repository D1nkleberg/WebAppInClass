<div id="<%= dom_id course %>">
  <div>
    <strong>Name:</strong>
    <%= course.name %>
  </div>

  <div>
    <strong>Department:</strong>
    <%= link_to course.department.name, department_path(course.department) %>

    <% if course.department.cool? %>
      <p>YES!!!!</p>
    <% end %>
  </div>

</div>
