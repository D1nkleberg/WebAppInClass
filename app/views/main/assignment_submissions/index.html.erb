<p style="color: green"><%= notice %></p>

<% content_for :title, "Assignment submissions" %>

<h1><%= @assignment.title %> - Submissions</h1>

<div id="assignment_submissions">
  <% @assignment_submissions.each do |assignment_submission| %>
    <%= render assignment_submission %>
    <p>
      <%= link_to "Show this assignment submission", main_submission_path(assignment_submission) %>
    </p>
  <% end %>
</div>

<%= link_to "New Submission", new_main_assignment_submission_path(@assignment) %>
