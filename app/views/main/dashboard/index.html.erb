<h1>Dashboard</h1>

<h2>My Courses</h2>

<ul>
  <% current_student.courses.each do |course| %>
    <li><%= link_to course.name, main_course_path(course) %></li>
  <% end %>
</ul>

<h2>My Assignments</h2>

<ul>
  <% current_student.assignments.each do |assignment| %>
    <li><%= link_to assignment.title, main_assignment_path(assignment) %></li>
  <% end %>
</ul>
