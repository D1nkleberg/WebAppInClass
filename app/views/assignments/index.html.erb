<p style="color: green"><%= notice %></p>

<% content_for :title, "Assignments" %>

<h1>Assignments</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Title</th>
      <th>Course</th>
      <th>Due Date</th>
      <th>Published</th>
    </tr>
  </thead>

  <tbody>
    <% @assignments.each do |assignment| %>
      <tr id="assignments">
        <td><%= link_to assignment.title, assignment_path(assignment) %></td>
        <td><%= assignment.course.name %></td>
        <td><%= assignment.due_date %></td>
        <td><%= assignment.published? %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New assignment", new_assignment_path %>
